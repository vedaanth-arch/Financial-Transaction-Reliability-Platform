{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch Java Program",
            "request": "launch",
            "mainClass": "com.financialplatform.financial_transaction_reliability_platform.FinancialTransactionReliabilityPlatformApplication"
        },



        {
            "type": "editor-browser",
            "request": "launch",
            "name": "Launch Integrated Browser against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
          "type": "java",
          "name": "Financial Platform DB preflight (no migration)",
          "request": "launch",
          "mainClass": "com.financialplatform.financial_transaction_reliability_platform.FinancialTransactionReliabilityPlatformApplication",
          "cwd": "${workspaceFolder}/financial-transaction-reliability-platform",
          "env": {
            "DB_URL": "jdbc:postgresql://localhost:5432/financial_transaction_platform",
            "DB_USERNAME": "financial_app"
          },
          "args": [
            "--spring.profiles.active=db",
            "--spring.flyway.enabled=false",
            "--spring.jpa.hibernate.ddl-auto=none",
            "--server.port=0"
          ]
        },
        {
          "type": "java",
          "name": "Financial Platform DB migrate",
          "request": "launch",
          "mainClass": "com.financialplatform.financial_transaction_reliability_platform.FinancialTransactionReliabilityPlatformApplication",
          "cwd": "${workspaceFolder}/financial-transaction-reliability-platform",
          "env": {
            "DB_URL": "jdbc:postgresql://localhost:5432/financial_transaction_platform",
            "DB_USERNAME": "financial_app"
          },
          "args": [
            "--spring.profiles.active=db",
            "--server.port=0"
          ]
        }
    ]
}
